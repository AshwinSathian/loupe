# Cloudflare serves ./dist straight from its edge, so these apply to every file.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Speculation-Rules: "/speculation.json"
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://raw.githubusercontent.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Rules for instant navigation: prerender a page when a link is hovered or pressed, prefetch the bar links. Served as a
# file because the CSP forbids inline scripts, and the inline form of the rules counts as one.
/speculation.json
  Content-Type: application/speculationrules+json
  Cache-Control: public, max-age=3600

# Pages: fresh for a minute, then served from the browser cache while it revalidates in the background, so a second
# visit or a back/forward costs no network wait. The Link header lets Cloudflare send the font as a 103 Early Hint.
# The font's hashed file name is filled in at build time (astro.config.mjs).
/
  Cache-Control: public, max-age=60, stale-while-revalidate=600
  Link: <__FONT__>; rel=preload; as=font; type=font/woff2; crossorigin
/method
  Cache-Control: public, max-age=60, stale-while-revalidate=600
  Link: <__FONT__>; rel=preload; as=font; type=font/woff2; crossorigin
/cases
  Cache-Control: public, max-age=60, stale-while-revalidate=600
  Link: <__FONT__>; rel=preload; as=font; type=font/woff2; crossorigin
/cases/*
  Cache-Control: public, max-age=60, stale-while-revalidate=600
  Link: <__FONT__>; rel=preload; as=font; type=font/woff2; crossorigin
/testing
  Cache-Control: public, max-age=60, stale-while-revalidate=600
  Link: <__FONT__>; rel=preload; as=font; type=font/woff2; crossorigin
/tools
  Cache-Control: public, max-age=60, stale-while-revalidate=600
  Link: <__FONT__>; rel=preload; as=font; type=font/woff2; crossorigin
/specimen
  Cache-Control: public, max-age=60, stale-while-revalidate=600
  Link: <__FONT__>; rel=preload; as=font; type=font/woff2; crossorigin
/faq
  Cache-Control: public, max-age=60, stale-while-revalidate=600
  Link: <__FONT__>; rel=preload; as=font; type=font/woff2; crossorigin

# Hashed build output: never changes.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed files: revalidate each hour so an edit shows up quickly.
/og/*
  Cache-Control: public, max-age=3600
/og.png
  Cache-Control: public, max-age=3600
/loupe-measure.js
  Cache-Control: public, max-age=3600
/favicon.svg
  Cache-Control: public, max-age=86400

# Files meant to be read by in-browser agents.
/llms.txt
  Access-Control-Allow-Origin: *
/llms-full.txt
  Access-Control-Allow-Origin: *
