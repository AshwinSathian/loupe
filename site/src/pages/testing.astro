---
import Base from '../layouts/Base.astro'
import VerifySeal from '../components/VerifySeal.astro'
import { html, section } from '../lib/md'
import { pairs, ready, resultMd } from '../lib/round'
import { check, results } from '../lib/results'
import { readRepo } from '../lib/repo'
import { article, blob, breadcrumb, site, tree } from '../lib/site'

// The commit that added keys.sha256 and the pre-registration, before any run.
const SEAL = '98a41da7deea7a01fcd89100a27b2fd26751c5c8'
const P = 'evals/heldout/preregistration.md'

const description =
  'How loupe was tested: a pre-registered blind round on three fixtures it was never tuned against, three Claude models, three judges, sealed answer keys, and every result including the losses.'

const fixtureName: Record<string, string> = {
  'web-sloppy': 'Lendwell (flawed web page)',
  'web-good': 'Split the check (control)',
  native: 'Dosewise (SwiftUI)',
}
const caseSlug: Record<string, string> = { 'web-sloppy': 'lendwell', 'web-good': 'split-the-check', native: 'dosewise' }

// A build without the round's files would ship an empty page; fail instead.
if (!ready()) throw new Error('evals/heldout is missing result.md or a judge file')
check()
const rows = pairs()
const notes = readRepo('evals/heldout/notes.md').replace(/^# .*\n/, '').replace(/^Written[^\n]*\n/m, '')
---

<Base
  title="Testing"
  description={description}
  path="/testing"
  card="testing"
  schema={[breadcrumb(['Testing', '/testing']), article('How loupe was tested', description, '/testing')]}
>
  <header class="page-head">
    <h1>{results.headline}</h1>
    <p class="lede">{results.summary}</p>
  </header>

  <section class="section" aria-labelledby="design-h">
    <header>
      <h2 id="design-h">How the round worked</h2>
      <p>
        The rules below were written and committed before any review ran (<a href={blob(P)}>preregistration.md</a>). The
        answer keys were sealed by hash in the same commit.
      </p>
    </header>
    <div class="prose quoted" set:html={html(section(P, 'Fixtures'))} />
    <div class="prose quoted" set:html={html(section(P, 'Conditions and runs'))} />
    <div class="prose quoted" set:html={html(section(P, 'Decision rules'))} />
    <div class="prose">
      <h3>Check the seal yourself</h3>
      <p>
        This fetches the key hashes as committed before any review ran (commit{' '}
        <a href={`${site.repo}/commit/${SEAL}`}><code>{SEAL.slice(0, 7)}</code></a>) and the keys as published now, both
        from GitHub, and hashes the keys in your browser.
      </p>
    </div>
    <VerifySeal commit={SEAL} />
  </section>

  <section class="section" aria-labelledby="result-h">
    <header>
      <h2 id="result-h">Results against the four rules</h2>
      <p>
        Produced by <a href={blob('evals/heldout/tally.py')}>tally.py</a> from the judges’ and scorer’s files. Unedited.
      </p>
    </header>
    <div class="prose report" set:html={html(resultMd().replace(/^# .*\n/, ''), 1)} />
  </section>

  <section class="section" aria-labelledby="reading-h">
    <header>
      <h2 id="reading-h">What the result means and what changed</h2>
      <p>From <a href={blob('evals/heldout/notes.md')}>notes.md</a>, written after the tally.</p>
    </header>
    <div class="prose" set:html={html(notes, 1)} />
  </section>

  <section class="section" aria-labelledby="pairs-h">
    <header>
      <h2 id="pairs-h">All nine pairs and each judge’s vote</h2>
      <p>
        Each judge saw the two reports as A and B and was not told which used loupe. “Flagged” counts the findings that
        judge called wrong or inflated.
      </p>
    </header>
    {
      rows.map((p) => (
        <details>
          <summary>
            {p.name}: {fixtureName[p.fixture]}, written by Claude {p.model}
          </summary>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">Judge</th>
                  <th scope="col">Preferred</th>
                  <th scope="col" class="num">Flagged, loupe</th>
                  <th scope="col" class="num">Flagged, no skill</th>
                  <th scope="col">Reason given</th>
                </tr>
              </thead>
              <tbody>
                {p.votes.map((v) => (
                  <tr>
                    <th scope="row">{v.judge}</th>
                    <td>{v.prefer}</td>
                    <td class="num"><span class="m">{v.flaggedSkill}</span></td>
                    <td class="num"><span class="m">{v.flaggedBase}</span></td>
                    <td>{v.reason}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="hint">
            <a href={`/cases/${caseSlug[p.fixture]}#${p.model}-h`}>Read both reports</a>
          </p>
        </details>
      ))
    }
  </section>

  <section class="section" aria-labelledby="limits-h">
    <header>
      <h2 id="limits-h">What this does not show</h2>
    </header>
    <div class="prose quoted" set:html={html(section(P, 'Known limits, stated in advance'))} />
    <p>
      Everything is in <a href={tree('evals/heldout')}>evals/heldout/</a>: fixtures, prompts, all 18 reports, the judges’
      answers, the scorer’s marks, and the keys, which you can check against{' '}
      <a href={blob('evals/heldout/keys.sha256')}>keys.sha256</a>.
    </p>
  </section>
</Base>
