---
interface Props {
  text: string
  label: string
  quiet?: boolean
}
const { text, label, quiet = false } = Astro.props
---

<div class="cmd-wrap">
  <div class="cmd">
    <pre><code>{text}</code></pre>
    <button type="button" class:list={[{ quiet }]} data-copy hidden>
      <span data-copy-label>Copy</span><span class="visually-hidden"> {label}</span>
    </button>
  </div>
  <p class="hint" role="status" data-copy-status></p>
</div>

<script>
  import '../scripts/command'
</script>
