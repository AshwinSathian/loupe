{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static assets only: the site is Astro's static output (dist/), served from Cloudflare's edge with no Worker script.
  "name": "loupe-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // /method serves method.html; /method/ redirects to it.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [{ "pattern": "loupe.ashwinsathian.com", "custom_domain": true }]
}
